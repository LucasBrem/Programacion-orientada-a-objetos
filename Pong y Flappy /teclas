boolean is_w = false, is_s = false, is_o = false, is_l = false;

void keyPressed() {
  if (key == 'w' || key == 'W') is_w = true;
  if (key == 's' || key == 'S') is_s = true;
  if (key == 'o' || key == 'O') is_o = true;
  if (key == 'l' || key == 'L') is_l = true;

  if (estado == 0) {
    if (key == '1') {
      pelotaPong = new Circulo(width / 2, height / 2, 10, 4, 4);
      paleta1 = new Cuadrado(30, height / 2, 20, 80);
      paleta2 = new Cuadrado(width - 30, height / 2, 20, 80);
      ptosP1 = 0;
      ptosP2 = 0;
      estado = 1;
    }
    if (key == '2') {
      bird = new Circulo(100, height / 2, 15);
      tubos = new ArrayList<DuplaDeTubos>();
      tiempoTubo = millis();
      estado = 2;
    }
  }

  if (estado == 2 && key == ' ') {
    bird.saltar(-7);
  }

  if (estado == 3 && key == ' ') {
    estado = 0;
  }
}

void keyReleased() {
  if (key == 'w' || key == 'W') is_w = false;
  if (key == 's' || key == 'S') is_s = false;
  if (key == 'o' || key == 'O') is_o = false;
  if (key == 'l' || key == 'L') is_l = false;
}
